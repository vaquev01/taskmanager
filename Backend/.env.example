# Database (PostgreSQL)
DATABASE_URL="postgresql://admin:password@localhost:5432/taskflow?schema=public"

# JWT Secret (troque por uma chave segura em produção)
JWT_SECRET="troque-por-uma-chave-segura-aleatoria"

# OpenAI API (for WhatsApp AI bot - GPT-4o-mini + Whisper)
OPENAI_API_KEY="your-openai-api-key-here"

# VAPID Keys (for Web Push Notifications)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Chrome/Chromium path (optional, for WhatsApp headless browser)
# CHROME_BIN="/usr/bin/chromium"

# Server
PORT=4000

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
